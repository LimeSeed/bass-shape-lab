{
  "name": "bass-transcribe-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node tests/independent-marks.mjs && node tests/independent-touch.mjs && node tests/storage.mjs && node tests/load-races.mjs && node tests/production.mjs && node tests/update-cache.mjs",
    "test:dsp": "node tests/dsp-check.mjs && node tests/dsp-stress.mjs",
    "test:cleanup": "node tests/independent-marks.mjs",
    "test:regions": "node tests/independent-marks.mjs",
    "test:practice": "node --test tests/practice.mjs",
    "test:updates": "node tests/update-cache.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "signalsmith-stretch": "1.3.2",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@playwright/test": "^1.56.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "@types/node": "^24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
